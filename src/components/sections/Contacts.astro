---
// #kontakty: the exit of the wayfinding. Address, both numbers, hours (W-F006), e-mail, map.
import { address, phones, email, hours } from "../../data/clinic";
import Plaque from "../Plaque.astro";
import Arrow from "../Arrow.astro";
---
<section id="kontakty" class="contacts on-dark block" data-rec="UX-R004,WA-R003" aria-labelledby="kontakty-h">
  <div class="container">
    <Plaque title="Контакти" note="Один вхід на Мейтуса, 5" headingId="kontakty-h" sticky={false} />
    <div class="contacts__body">
      <div class="contacts__place">
        <p class="contacts__street">{address.street}</p>
        <p>{address.city}, {address.near}</p>
        <a class="text-link" href={address.map} target="_blank" rel="noopener">Відкрити на карті <Arrow /></a>
      </div>
      <ul class="contacts__phones">
        <li>
          <span class="contacts__label">{phones.urgent.label}, контакт-центр</span>
          <a class="contacts__num num" href={phones.urgent.href}>{phones.urgent.display}</a>
        </li>
        <li>
          <span class="contacts__label">Запис на прийом</span>
          <a class="contacts__num num" href={phones.booking.href}>{phones.booking.display}</a>
        </li>
        <li>
          <span class="contacts__label">E-mail</span>
          <a class="contacts__mail" href={email.href}>{email.display}</a>
        </li>
      </ul>
      <ul class="contacts__hours">
        <li>{hours.emergency}</li>
        <li>Планові консультації: <span class="num">пн–сб 8:00–20:00</span>, <span class="num">нд 9:00–18:00</span></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contacts { --pad-top: var(--space-3xl); --pad-bottom: var(--space-2xl); }
  .contacts__body { display: grid; gap: var(--space-2xl); margin-top: var(--space-xl); }
  .contacts__place { display: grid; gap: var(--space-sm); justify-items: start; }
  .contacts__street { font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-section); line-height: 1.08; letter-spacing: -0.015em; text-wrap: balance; }
  .contacts__phones { display: grid; gap: var(--space-lg); }
  .contacts__phones li { display: grid; gap: var(--space-2xs); }
  .contacts__label { font-size: var(--text-sm); }
  .contacts__num {
    display: inline-flex; align-items: center; min-height: 48px; width: fit-content;
    font-family: var(--font-display); font-weight: var(--weight-display); font-size: var(--text-title); line-height: 1.1;
    color: var(--color-on-dark); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px;
    text-decoration-color: var(--color-line-on-dark); transition: text-decoration-color var(--dur-hover) var(--ease-out);
  }
  .contacts__phones li:first-child .contacts__num { text-decoration-color: var(--color-urgent); }
  .contacts__phones li:nth-child(2) .contacts__num { text-decoration-color: var(--color-accent); }
  .contacts__mail { display: inline-flex; align-items: center; min-height: 44px; width: fit-content; font-weight: var(--weight-strong); text-underline-offset: 4px; }
  @media (hover: hover) {
    .contacts__num:hover, .contacts__phones li .contacts__num:hover { text-decoration-color: var(--color-on-dark); }
    .contacts__mail:hover { text-decoration-thickness: 2px; }
  }
  .contacts__num:active { text-decoration-color: var(--color-on-dark); }
  @media (max-width: 59.99rem) {
    .contacts__num {
      width: 100%; min-height: 64px; padding: var(--space-sm) var(--space-md); text-decoration: none;
      border: 2px solid var(--color-accent); border-radius: var(--radius);
    }
    .contacts__phones li:first-child .contacts__num { border-color: var(--color-urgent); }
  }
  .contacts__hours { display: grid; align-content: start; border-top: 1px solid var(--color-line-on-dark); }
  .contacts__hours li { padding-block: var(--space-md); border-bottom: 1px solid var(--color-line-on-dark); }
  @media (min-width: 60rem) {
    .contacts { --pad-top: var(--space-4xl); }
    .contacts__body { grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 4fr); column-gap: var(--space-2xl); margin-top: var(--space-2xl); }
  }
</style>
