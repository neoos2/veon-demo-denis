---
// #napriamky: the index of directions. Tabs by group + a filter by name; each row is a future page (FutureLink).
import { directionGroups, phones } from "../../data/clinic";
import Plaque from "../Plaque.astro";
import FutureLink from "../FutureLink.astro";
import CallButton from "../CallButton.astro";
---
<section id="napriamky" class="dirs block" data-rec="UX-R002,G-R007" aria-labelledby="napriamky-h">
  <div class="container">
    <Plaque title="До лікаря" note="Дорослі й дитячі напрямки" headingId="napriamky-h" />

    <div class="dirs__index" data-directions>
      <div class="dirs__tools">
        <div class="dirs__tabs" role="tablist" aria-label="Групи напрямків">
          {directionGroups.map((g, i) => (
            <button type="button" role="tab" id={`tab-${g.id}`} aria-controls={`panel-${g.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{g.title}</button>
          ))}
        </div>
        <div class="dirs__search" role="search">
          <label for="dir-filter">Знайти напрямок</label>
          <input id="dir-filter" name="napriamok" type="search" autocomplete="off" enterkeyhint="search" placeholder="Наприклад, кардіологія" data-filter />
          <p class="visually-hidden" role="status" data-status></p>
        </div>
      </div>

      <div class="dirs__lists" data-lists>
        {directionGroups.map((g) => (
          <div class="dirs__panel" role="tabpanel" id={`panel-${g.id}`} aria-labelledby={`tab-${g.id}`}>
            <h3 class="dirs__group">{g.title}</h3>
            <ul class="dirs__list">
              {g.items.map((name) => (
                <li data-name={name}><FutureLink arrow class="dirs__row">{name}</FutureLink></li>
              ))}
            </ul>
          </div>
        ))}
        <div class="dirs__empty" data-empty hidden>
          <p>Не знайшли? Зателефонуйте — підкажемо лікаря.</p>
          <a class="text-link num" href={phones.booking.href}>{phones.booking.display}</a>
        </div>
      </div>

      <div class="dirs__foot">
        <FutureLink arrow class="dirs__all">Усі 74 напрямки</FutureLink>
        <CallButton kind="booking" label="Записатися до лікаря" />
      </div>
    </div>
  </div>
</section>

<style>
  .dirs { --pad-top: var(--space-3xl); --pad-bottom: var(--space-3xl); }
  .dirs__index { margin-top: var(--space-xl); }
  .dirs__tools { display: grid; gap: var(--space-lg); }
  .dirs__tabs { display: none; }
  :global(.is-enhanced) .dirs__tabs {
    display: flex; gap: var(--space-xs); overflow-x: auto; scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter)); padding: var(--space-2xs) var(--gutter);
  }
  .dirs__tabs button {
    flex-shrink: 0; min-height: 48px; padding: 0 var(--space-md); white-space: nowrap;
    border: 1px solid var(--color-rule); border-radius: var(--radius); background: transparent;
    font-weight: var(--weight-strong); font-size: var(--text-md); cursor: pointer;
    transition: background-color var(--dur-hover) var(--ease-out), color var(--dur-hover) var(--ease-out);
  }
  .dirs__tabs button[aria-selected="true"] { background: var(--color-brand); border-color: var(--color-brand); color: var(--color-on-dark); }
  .dirs__tabs button:active { background: var(--color-paper-2); }
  .dirs__tabs button[aria-selected="true"]:active { background: var(--color-brand-hover); }
  @media (hover: hover) {
    .dirs__tabs button:hover { background: var(--color-paper-2); }
    .dirs__tabs button[aria-selected="true"]:hover { background: var(--color-brand-hover); }
  }
  :global(.is-searching) .dirs__tabs button[aria-selected="true"] { background: transparent; color: var(--color-text); border-color: var(--color-brand); }

  .dirs__search { display: none; gap: var(--space-xs); }
  :global(.js) .dirs__search { display: grid; }
  .dirs__search label { font-weight: var(--weight-strong); font-size: var(--text-sm); }
  .dirs__search input {
    min-height: 52px; width: 100%; padding: 0 var(--space-md);
    border: 1px solid var(--color-muted); border-radius: var(--radius); background: var(--color-bg);
    font-size: var(--text-md);
  }
  .dirs__search input::placeholder { color: var(--color-muted); opacity: 1; }
  .dirs__search input:focus-visible { outline: 3px solid var(--color-focus); outline-offset: 0; }

  .dirs__lists { margin-top: var(--space-lg); transition: opacity var(--dur-short) var(--ease-out); }
  .dirs__lists:global(.is-leaving) { opacity: 0; transition-duration: var(--dur-micro); }
  .dirs__panel + .dirs__panel { margin-top: var(--space-xl); }
  :global(.is-enhanced) .dirs__panel + .dirs__panel { margin-top: 0; }
  :global(.is-enhanced.is-searching) .dirs__panel + .dirs__panel { margin-top: var(--space-xl); }
  .dirs__group { font-size: var(--text-lg); line-height: 1.2; margin-bottom: var(--space-sm); }
  :global(.is-enhanced:not(.is-searching)) .dirs__group { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .dirs__list { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: var(--space-lg); border-top: 1px solid var(--color-rule); }
  .dirs__list li { border-bottom: 1px solid var(--color-rule); }
  .dirs__list :global(.dirs__row) {
    display: flex; justify-content: space-between; width: 100%; min-height: 52px; padding: var(--space-xs) var(--space-2xs);
    font-size: var(--text-md); color: var(--color-text);
  }
  .dirs__list :global(.dirs__row .arrow) { --arrow: 14px; color: var(--color-brand); }
  .dirs__list :global(.dirs__row:focus-visible) { outline-offset: -3px; }
  @media (hover: hover) { .dirs__list :global(.dirs__row:hover) { background: var(--color-paper-2); } }

  .dirs__empty { display: grid; gap: var(--space-xs); justify-items: start; padding: var(--space-lg) 0; border-top: 1px solid var(--color-rule); }
  .dirs__empty p { font-size: var(--text-lg); font-family: var(--font-display); font-weight: var(--weight-display); line-height: 1.2; }

  .dirs__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-lg); margin-top: var(--space-xl); }
  .dirs__foot :global(.dirs__all) { min-height: 48px; font-weight: var(--weight-strong); color: var(--color-brand); }

  @media (min-width: 40rem) {
    .dirs__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 60rem) {
    .dirs { --pad-top: var(--space-3xl); --pad-bottom: var(--space-4xl); }
    .dirs__tools { grid-template-columns: minmax(0, 1fr) minmax(0, 22rem); align-items: end; }
    :global(.is-enhanced) .dirs__tabs { margin: 0; padding: var(--space-2xs) 0; flex-wrap: wrap; overflow: visible; }
    .dirs__list { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--space-xl); }
  }
</style>
