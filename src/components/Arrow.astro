---
// Triangle arrow from the geometry of the DENIS mark. Decorative: the text beside it carries the meaning.
interface Props { urgent?: boolean; class?: string; }
const { urgent = false, class: cls } = Astro.props;
---
<span class:list={["arrow", { "arrow--urgent": urgent }, cls]} aria-hidden="true">
  <svg viewBox="0 0 20 20" width="20" height="20" focusable="false"><path d="M4 2.5 17.5 10 4 17.5Z" fill="currentColor" /></svg>
</span>
